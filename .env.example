# Copy to .env and fill in. Generate keys with: npm run gen:key
PORT=3000
# Base64 of 32 random bytes (npm run gen:key)
ENCRYPTION_KEY=
DATABASE_PATH=./data/app.db
NODE_ENV=development

# Only needed for the NHI Blog Digest (npm run digest)
ANTHROPIC_API_KEY=
# An API key created in the app's "API key" panel
DIGEST_API_KEY=
# Jira project that receives the digest ticket, for example SEC
DIGEST_PROJECT_KEY=
DIGEST_API_URL=http://localhost:3000
BLOG_URL=https://www.oasis.security/blog
